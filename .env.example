# Names only. Leave values empty in this example. Copy to .env and fill them on the server.
# Never put these values in frontend code, browser storage, or API responses.

# Optional. GoPlus allows the free token-security call without a token.
# Set both to send the documented bearer token. https://docs.gopluslabs.io/reference/getaccesstokenusingpost
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Required for Quick Intel. https://developer.quickintel.io/
QUICKINTEL_API_KEY=

# Optional. Honeypot.is currently documents that a key is not required.
HONEYPOT_API_KEY=

# Required for Blockaid. https://docs.blockaid.io/docs/introduction
BLOCKAID_API_KEY=

# Required for Token Sniffer. https://tokensniffer.readme.io/reference/api-key
TOKENSNIFFER_API_KEY=

# Required for De.Fi. Request a key from info@de.fi. https://docs.de.fi/api/api
DEFI_API_KEY=

# Required for DEXTools. https://developer.dextools.io/
DEXTOOLS_API_KEY=
# trial, standard, advanced, or pro. Defaults to trial when the key is set and this is empty.
DEXTOOLS_PLAN=

# Optional RPC overrides. Public endpoints are used when a value is empty.
RPC_URL_1=
RPC_URL_56=
RPC_URL_137=
RPC_URL_42161=
RPC_URL_8453=
RPC_URL_10=
RPC_URL_43114=
